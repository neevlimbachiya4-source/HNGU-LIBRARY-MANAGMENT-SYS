# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STUDENT_SESSION_SECRET: HMAC-SHA256 secret for signing student session tokens (12-hour expiry).
# Must be set to a strong random string (>= 32 chars) in AI Studio Environment Variables.
STUDENT_SESSION_SECRET="your_secure_student_session_secret_at_least_32_chars_long"

# SYSTEM_SERVICE_EMAIL & SYSTEM_SERVICE_PASSWORD:
# Used strictly on the server (server.ts) to authenticate with Firebase Auth as a dedicated system user.
# Never bundled into client-side code or exposed to the browser.
SYSTEM_SERVICE_EMAIL="system-backend@speedy-park-5tsmh.firebaseapp.com"
SYSTEM_SERVICE_PASSWORD="secure_system_backend_password_here"
